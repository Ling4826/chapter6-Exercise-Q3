<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Pane?>

<FlowPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="se233.inverted.chapter3.controller.MainViewController">
    <children>
        <MenuBar prefWidth="400.0">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem text="Close" onAction="#handleCloseAction" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <AnchorPane prefHeight="375.0" prefWidth="200.0">
            <children>
                <Label layoutX="14.0" layoutY="14.0" text="Drop PDF files below:" />
                <ListView fx:id="inputListView" layoutX="10.0" layoutY="45.0" prefHeight="250.0" prefWidth="180.0" style="-fx-border-color: black; -fx-border-width: 1;" />
                <Button fx:id="startButton" layoutX="10.0" layoutY="310.0" prefWidth="180.0" text="Start Indexing" />
            </children>
        </AnchorPane>
        <Pane prefHeight="375.0" prefWidth="200.0">
            <children>
                <ListView fx:id="listView" layoutY="14.0" prefHeight="350.0" prefWidth="200.0" />
            </children>
        </Pane>
    </children>
</FlowPane>